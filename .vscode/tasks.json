{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "${config:cmake.cmakePath}",
            "args": [
                "-B", "build",
                "-S", ".",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-G", "Ninja"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure CMake project with Ninja"
        },
        {
            "label": "CMake Configure Release",
            "type": "shell",
            "command": "${config:cmake.cmakePath}",
            "args": [
                "-B", "build",
                "-S", ".",
                "-DCMAKE_BUILD_TYPE=Release",
                "-G", "Ninja"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure CMake project for Release with Ninja"
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "${config:cmake.cmakePath}",
            "args": [
                "--build", "build",
                "--config", "Debug",
                "--parallel"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"],
            "detail": "Build the project",
            "dependsOn": "CMake Configure"
        },
        {
            "label": "CMake Build Release",
            "type": "shell",
            "command": "${config:cmake.cmakePath}",
            "args": [
                "--build", "build",
                "--config", "Release",
                "--parallel"
            ],
            "group": "build",
            "problemMatcher": ["$msCompile"],
            "detail": "Build the project in Release mode",
            "dependsOn": "CMake Configure Release"
        },
        {
            "label": "CMake Clean",
            "type": "shell",
            "command": "${config:cmake.cmakePath}",
            "args": [
                "--build", "build",
                "--target", "clean"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean build artifacts"
        },
        {
            "label": "CMake Clean Rebuild",
            "type": "shell",
            "command": "${config:cmake.cmakePath}",
            "args": [
                "--build", "build",
                "--clean-first",
                "--config", "Debug"
            ],
            "group": "build",
            "problemMatcher": ["$msCompile"],
            "detail": "Clean and rebuild the project"
        }
    ]
}
