{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/src/core/**",
                "${workspaceFolder}/src/qt/**",
                "${workspaceFolder}/third_party/SDL2/include/**",
                "${workspaceFolder}/third_party/steamworks/sdk/public/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "STEAMWORKS_AVAILABLE"
            ],
            "windowsSdkVersion": "10.0.22000.0",
            "compilerPath": "cl.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-msvc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        },
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/src/core/**",
                "${workspaceFolder}/src/qt/**",
                "/usr/include/SDL2",
                "${workspaceFolder}/third_party/steamworks/sdk/public/**"
            ],
            "defines": [
                "_DEBUG",
                "STEAMWORKS_AVAILABLE"
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}
